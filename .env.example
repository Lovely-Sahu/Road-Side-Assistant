# Copy to your environment (PowerShell: $env:NAME="value"; cmd: set NAME=value). Never commit real secrets.
RSA_ENV=development                 # production enables secure cookies, disables debug + demo seeding
RSA_SECRET_KEY=                     # REQUIRED in production: python -c "import secrets; print(secrets.token_hex(32))"
RSA_DATABASE_PATH=                  # default: <project>/rsa.db
RSA_HOST=127.0.0.1                  # 0.0.0.0 to allow other devices on your network
PORT=5000
RSA_DEBUG=0
RSA_TRUST_PROXY=0                   # 1 when behind an HTTPS reverse proxy
RSA_SESSION_COOKIE_SECURE=0         # forced on in production
RSA_SESSION_HOURS=8
RSA_LOG_LEVEL=INFO
# Login protection
RSA_LOGIN_MAX_FAILURES=5
RSA_LOGIN_WINDOW_MINUTES=15
# Providers / matching
RSA_PROVIDER_AUTO_APPROVE=0         # 1 = new providers receive jobs without admin verification (demos only)
RSA_ALLOW_UNLINKED_PROVIDERS=0      # 1 = dispatch providers that have no login (someone must update them)
RSA_MAX_SERVICE_RADIUS_KM=50
RSA_PROVIDER_MAX_ACTIVE_JOBS=1
RSA_MAX_ACTIVE_REQUESTS_PER_DRIVER=1
# Escalation
RSA_ESCALATION_MINUTES=5
RSA_ACCEPT_TIMEOUT_MINUTES=10
RSA_AUTO_REASSIGN_ON_TIMEOUT=0
# Tracking / maps
RSA_LOCATION_MIN_INTERVAL_SECONDS=10
RSA_LOCATION_STALE_SECONDS=120
RSA_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
RSA_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
RSA_ROUTING_URL=                    # optional OSRM-compatible router, e.g. your own OSRM server
# Uploads
RSA_MAX_UPLOAD_MB=8
RSA_MAX_PHOTOS_PER_REQUEST=3
# E-mail notifications (optional)
RSA_SMTP_HOST=
RSA_SMTP_PORT=587
RSA_SMTP_USER=
RSA_SMTP_PASSWORD=
RSA_SMTP_FROM=
RSA_SMTP_STARTTLS=1
